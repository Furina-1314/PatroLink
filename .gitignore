# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.env

# ---- Editors / OS ----
.idea/
.vscode/
/.vs
.vs/
.DS_Store
Thumbs.db

# ---- Experiment artifacts (large, not in git) ----
data/
results/
*.parquet
*.onnx
